{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/Muratovnik/tolmach/main/tools/catalog.schema.json",
  "title": "Tolmach catalog",
  "description": "One tolmach-<id>.json file: the identity of one mod and its Russian texts. The plugin reads the same shape (src/Models.cs); tools/validate.py checks this schema first, then what a schema cannot express.",
  "type": "object",
  "required": ["id", "package", "version", "pluginVersion", "assembly", "guids", "namespaces", "words", "englishWords", "texts", "patterns", "returns", "prefabs", "sourceFiles", "notes"],
  "additionalProperties": false,
  "properties": {
    "id": {"type": "string", "pattern": "^[A-Za-z0-9_.]+$"},
    "package": {"type": "string"},
    "version": {"$ref": "#/$defs/version", "description": "Package version (Gale/Thunderstore)."},
    "pluginVersion": {"$ref": "#/$defs/version", "description": "BepInPlugin version the IL adapters were checked against."},
    "assembly": {"$ref": "#/$defs/text"},
    "codeAssembly": {"type": "string", "pattern": "^[A-Za-z0-9_.-]+$", "description": "Optional display-only helper: a direct plugin reference with an exact, uniquely loaded assembly identity."},
    "guids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/name"}},
    "namespaces": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/name"}, "description": "<global> marks types outside any namespace."},
    "words": {"$ref": "#/$defs/keyTable"},
    "englishWords": {"$ref": "#/$defs/keyTable", "description": "englishWords[k] == k marks a key the mod uses without English text."},
    "replaceNative": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1},
                      "description": "Keys of words whose Russian replaces the mod's own Russian (an owner's decision); every other key is fill-only."},
    "texts": {"$ref": "#/$defs/table"},
    "mapLabels": {"$ref": "#/$defs/table"},
    "rawTexts": {"$ref": "#/$defs/table"},
    "nameAliases": {
      "type": "object", "maxProperties": 16,
      "propertyNames": {"pattern": "^\\$item_upgrader_tier[0-7] \\$item_upgrader_(weapon|armor) \\$item_upgrader_name$"},
      "additionalProperties": {"type": "string", "pattern": "^\\$tolmach_idol_[0-7]_(weapon|armor)$"},
      "description": "Valheim's 16 exact composite idol names mapped to this catalog's own complete-name keys. No ordinary token-preservation exception."
    },
    "patterns": {"type": "array", "items": {"$ref": "#/$defs/pattern"}},
    "rawPatterns": {"type": "array", "items": {"$ref": "#/$defs/rawPattern"}},
    "returns": {"type": "array", "items": {"$ref": "#/$defs/method"}},
    "composed": {"type": "array", "items": {"$ref": "#/$defs/composed"}},
    "literals": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "configTexts": {"type": "array", "items": {"$ref": "#/$defs/rule"}},
    "prefabs": {"type": "array", "items": {"$ref": "#/$defs/prefab"}},
    "terms": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z0-9_]+$"},
      "additionalProperties": {"$ref": "#/$defs/table", "minProperties": 1}
    },
    "cllc": {"$ref": "#/$defs/cllc"},
    "sourceFiles": {"type": "array", "items": {"$ref": "#/$defs/text"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "text": {"type": "string", "minLength": 1},
    "name": {"type": "string", "pattern": "^\\S+$"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+(?:\\.[0-9]+){0,2}$"},
    "table": {
      "type": "object",
      "propertyNames": {"minLength": 1},
      "additionalProperties": {"$ref": "#/$defs/text"}
    },
    "keyTable": {
      "type": "object",
      "propertyNames": {"pattern": "^[A-Za-z0-9_]+$"},
      "additionalProperties": {"$ref": "#/$defs/text"}
    },
    "method": {
      "type": "object",
      "required": ["type", "method"],
      "additionalProperties": false,
      "properties": {"type": {"$ref": "#/$defs/text"}, "method": {"$ref": "#/$defs/text"}}
    },
    "rule": {
      "type": "object",
      "required": ["type", "method", "values"],
      "additionalProperties": false,
      "properties": {
        "type": {"$ref": "#/$defs/text"},
        "method": {"$ref": "#/$defs/text"},
        "values": {"$ref": "#/$defs/table", "minProperties": 1}
      }
    },
    "prefab": {
      "type": "object",
      "required": ["name", "kind", "fields"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "kind": {"type": "string"},
        "fields": {"$ref": "#/$defs/table"}
      }
    },
    "pattern": {
      "type": "object",
      "required": ["source", "target"],
      "additionalProperties": false,
      "properties": {
        "source": {"$ref": "#/$defs/text"},
        "target": {"$ref": "#/$defs/text"},
        "singleLine": {"type": "boolean", "description": "When true, placeholders cannot capture CR/LF; source and target must also be single-line."},
        "numeric": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "arguments": {
          "type": "object",
          "propertyNames": {"pattern": "^[0-9]+$"},
          "additionalProperties": {"type": "string", "pattern": "^(?:text|message|mapLabel|item|itemSet|term:[A-Za-z0-9_]+)$"}
        }
      }
    },
    "rawPattern": {
      "$ref": "#/$defs/pattern",
      "description": "Raw templates see every localized string, so they take text and term arguments only.",
      "properties": {
        "arguments": {"additionalProperties": {"pattern": "^(?:text|term:[A-Za-z0-9_]+)$"}}
      }
    },
    "composedPattern": {
      "type": "object",
      "description": "A pattern whose arguments may also be a name: the site's exact translation, a capture without Latin letters as it is, otherwise the template is not used.",
      "required": ["source", "target"],
      "additionalProperties": false,
      "properties": {
        "source": {"$ref": "#/$defs/text"},
        "target": {"$ref": "#/$defs/text"},
        "singleLine": {"type": "boolean"},
        "numeric": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 0}},
        "arguments": {
          "type": "object",
          "propertyNames": {"pattern": "^[0-9]+$"},
          "additionalProperties": {"type": "string", "pattern": "^(?:text|message|mapLabel|item|itemSet|name|term:[A-Za-z0-9_]+)$"}
        }
      }
    },
    "composed": {
      "type": "object",
      "description": "Texts and templates for strings a mod composes from its own parts. They apply only at the named sites: display calls, string results and fault-protected call sites of the mod's own methods, the string result of a game method, or Container.m_name on containers carrying one of the owner components. At game sites an item list limits the rule to the named items.",
      "additionalProperties": false,
      "anyOf": [{"required": ["sites"]}, {"required": ["containerOwners"]}],
      "properties": {
        "sites": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/method"}},
        "containerOwners": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}},
        "items": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/text"}, "description": "Prefab names (ItemData.m_dropPrefab) of the items whose text the rule's game sites translate; the rule then applies to no other item."},
        "texts": {"$ref": "#/$defs/table"},
        "patterns": {"type": "array", "items": {"$ref": "#/$defs/composedPattern"}}
      }
    },
    "nameplate": {
      "type": "string",
      "description": "CLLC's nameplate syntax: {name} once outside groups; each [...] group holds exactly one of {effect}, {infusion}, {affix}.",
      "pattern": "^(?:[^\\[\\]{}]|\\[[^\\[\\]{}]*\\{(?:effect|infusion|affix)\\}[^\\[\\]{}]*\\])*\\{name\\}(?:[^\\[\\]{}]|\\[[^\\[\\]{}]*\\{(?:effect|infusion|affix)\\}[^\\[\\]{}]*\\])*$"
    },
    "cllc": {
      "type": "object",
      "description": "Creature Level and Loot Control's own language table (its LocalizationWrapper).",
      "required": ["creatureGender", "genderedCreatureTranslations", "genderedTranslations", "translations", "enumTranslations", "settingGroups", "settings"],
      "additionalProperties": false,
      "properties": {
        "creatureGender": {"$ref": "#/$defs/table"},
        "genderedCreatureTranslations": {"type": "object", "additionalProperties": {"$ref": "#/$defs/nameplate"}},
        "genderedTranslations": {"type": "object", "additionalProperties": {"$ref": "#/$defs/table"}},
        "translations": {"$ref": "#/$defs/table"},
        "enumTranslations": {"type": "object", "additionalProperties": {"$ref": "#/$defs/table"}},
        "settingGroups": {"$ref": "#/$defs/table"},
        "settings": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["display", "desc"],
            "additionalProperties": false,
            "properties": {"display": {"$ref": "#/$defs/text"}, "desc": {"$ref": "#/$defs/text"}}
          }
        }
      }
    }
  }
}
